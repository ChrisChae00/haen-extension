# Benchmark harness
bench/.venv/
# FLORES tarball cache; regenerate with `npm run sample-flores`
bench/.cache/
# derived + seed-pinned; regenerate byte-identically with `npm run sample-flores`
bench/datasets/*/flores.jsonl
# distillation training sentences; regenerate byte-identically with `npm run sample-flores-train`
bench/datasets/train/raw.jsonl
bench/datasets/train/raw-idioms-ko.jsonl
# paid teacher batch state, raw responses, and derived train/valid files
bench/datasets/train/teacher/
bench/datasets/train/teacher-idioms-ko/
#
# Raw run output stays local and is NOT committed - predictions.jsonl for the full set
# across every model is large and churns. Keep it on disk forever regardless: re-scoring
# past runs with a new metric or a changed judge rubric needs the original outputs, and
# regenerating them costs real money.
# Commit only the summaries, by copying metrics.json + report.md into results-committed/.
bench/results/
# Same for runs pulled out of the comparison (dead model, failed run) but kept on disk.
bench/results_archive/
# Re-judging an existing run with a second judge, to measure judge agreement. Same shape
# as a run dir but not a run: the report must never read it as one.
bench/xjudge/
# Local-only working notes: handoffs, investigation memos, session state.
# Deliberately not committed - these are scratch context for whoever picks the work up
# next, not project documentation, and they go stale the moment they are.
# Working docs: session handoffs, plans, raw evidence dumps. They churn every session
# and describe what to do next, not what happened - the record that outlives them lives
# in docs/*.md, which is committed.
/docs/local/

__pycache__/

# MLX tuning venv and multi-GB fused checkpoints; rebuild with bench/tuning/*.py
.venv-mlx/
bench/tuning/zero-adapter/
bench/tuning/fused-untuned-control/
bench/tuning/adapters-run*/
bench/tuning/memory-*.log
bench/tuning/train-*.log
bench/tuning/fused-run*/
